# Leave VITE_LUMEN_API_URL unset to run on the bundled demo queue (synthetic patients).
# Set it to the orchestrator (FastAPI, ShreyasFastAPI branch) to use today's real queue;
# End then uploads the recording to POST /api/v1/consultations.
# VITE_LUMEN_API_URL=https://your-static-domain.ngrok-free.app
# VITE_LUMEN_API_KEY=change-me   # only if the orchestrator sets API_KEY. It ships inside the app, so rotate it after the demo.
